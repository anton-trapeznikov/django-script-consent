msgid "Code preview"
msgstr "Превью кода"

msgid "Changing the title or text automatically increments the version. This invalidates previously granted consents."
msgstr "При изменении заголовка или текста версия увеличивается автоматически. Это инвалидирует ранее выданные согласия."

msgid "System"
msgstr "Служебное"

msgid "Close"
msgstr "Закрыть"

msgid "Privacy policy"
msgstr "Политика конфиденциальности"

msgid "required"
msgstr "обязательные"

msgid "Accept selected"
msgstr "Принять выбранные"

msgid "Consent settings"
msgstr "Настройки согласия"

msgid "Recipient"
msgstr "Получатель"

msgid "Data recipient shown in the banner for this snippet's category. Leave empty to omit."
msgstr "Получатель данных, который показывается в баннере у категории этого сниппета. Оставьте пустым, чтобы скрыть."

msgid "Operator"
msgstr "Оператор"

msgid "Legal operator details shown in the banner footer. Leave empty to omit."
msgstr "Реквизиты оператора в подвале баннера. Оставьте пустым, чтобы скрыть."

msgid "Privacy policy URL"
msgstr "URL политики конфиденциальности"

msgid "Link shown in the banner. Changing it increments the banner version and invalidates prior consents. Leave empty to hide the link. Relative paths and http(s) only."
msgstr "Ссылка в баннере. При изменении версия баннера увеличивается, ранее выданные согласия инвалидируются. Оставьте пустым, чтобы скрыть ссылку. Только относительные пути и http(s)."

msgid "Banner impressions"
msgstr "Показы баннера"

msgid "Explicit closes"
msgstr "Явные закрытия"

msgid "Selected saved"
msgstr "Сохранения выбранных"

msgid "Statistics"
msgstr "Статистика"

msgid "Changing the title, text, operator, or privacy policy URL, or activating this configuration, automatically increments the version. Consent is bound to the active banner id and version; switching or editing invalidates previously granted consents."
msgstr "При изменении заголовка, текста, оператора или URL политики, а также при активации этой конфигурации версия увеличивается автоматически. Согласие привязано к id и версии активного баннера; переключение или правка инвалидирует ранее выданные согласия."

msgid "Recipients: %(names)s"
msgstr "Получатели: %(names)s"

msgid "Esc and × hide this dialog until the end of the day. Optional scripts stay off; only essential ones run. This is not consent to optional processing."
msgstr "Esc и крестик скрывают окно до конца дня. Опциональные скрипты не загружаются, работают только необходимые. Это не согласие на необязательную обработку."

msgid "Operator — %(operator)s. What we store and for how long —"
msgstr "Оператор — %(operator)s. Что храним и сколько —"

msgid "Personal data processing policy"
msgstr "Политика обработки персональных данных"
